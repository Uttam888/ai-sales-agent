# ============================================================
# AI Sales Agent - Root Gitignore
# ============================================================

# Python cache
__pycache__/
*.py[cod]
*.pyo

# Python virtual environments
venv/
test_venv/
.venv/

# Environment variables / secrets
.env
.env.*
!.env.example

# Node
node_modules/

# Frontend build output
dist/
dist-ssr/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# IDE / editor
.vscode/
.idea/
.DS_Store

# OS files
Thumbs.db

# Temporary files
*.tmp
*.temp

# Local development archive
.archive/
